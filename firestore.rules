rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /vehiculos/{vehiculoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.duenoId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.duenoId == request.auth.uid;
    }

    match /reservas/{reservaId} {
      // Solo ven la reserva el cliente y el dueño
      allow read: if request.auth != null
                  && (resource.data.clienteId == request.auth.uid
                      || resource.data.duenoId == request.auth.uid);

      // Se crea a nombre propio, en estado "solicitada", y el dueño debe ser el real del vehículo
      allow create: if request.auth != null
                    && request.resource.data.clienteId == request.auth.uid
                    && request.resource.data.estado == 'solicitada'
                    && request.resource.data.duenoId ==
                       get(/databases/$(database)/documents/vehiculos/$(request.resource.data.vehiculoId)).data.duenoId;

      allow update: if request.auth != null && (
            // el dueño solo puede cambiar el estado
            (resource.data.duenoId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']))
            // el cliente solo puede calificar, una vez, cuando ya finalizó
         || (resource.data.clienteId == request.auth.uid
              && resource.data.estado == 'finalizada'
              && resource.data.get('calificacion', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacion', 'comentario'])
              && request.resource.data.calificacion >= 1
              && request.resource.data.calificacion <= 5)
      );

      allow delete: if false;
    }

    // Un documento por vehículo y día reservado: evita la doble reserva
    match /ocupacion/{diaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.clienteId == request.auth.uid;
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.duenoId == request.auth.uid;
    }
  }
}